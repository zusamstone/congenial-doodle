{
  "name": "ai-studio-electron",
  "version": "1.0.0",
  "description": "Electron main process for AI Studio",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "package:win": "electron-builder --win portable",
    "package:mac": "electron-builder --mac",
    "package:linux": "electron-builder --linux AppImage",
    "package:all": "electron-builder -mwl"
  },
  "keywords": ["electron", "ai", "chat"],
  "author": "zusamstone",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  }
}
