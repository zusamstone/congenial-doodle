# AI Studio Backend Environment Configuration
# Copy this file to .env and configure as needed

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Application
APP_NAME=AI Studio
VERSION=0.1.0

# Paths (Portable Mode)
# All paths are relative to the application root for portability
DATA_DIR=./data
MODELS_DIR=./data/models
VECTOR_STORE_DIR=./data/vector_store
DATABASE_DIR=./data/database
UPLOADS_DIR=./data/uploads

# Database
DATABASE_NAME=ai_studio.db

# Default Models
DEFAULT_MODEL=
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Hardware Settings
DEFAULT_GPU_LAYERS=0
DEFAULT_THREADS=4

# Context Settings
DEFAULT_CONTEXT_LENGTH=4096
MAX_CONTEXT_LENGTH=32768

# RAG Settings
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_MAX_CHUNKS=5
DEFAULT_MIN_RELEVANCE=0.5

# API Keys (Optional - for API providers)
# Leave empty if not using API providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Security
# Generate a secure encryption key for API key encryption
# Example: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/logs/ai_studio.log
